# Cloudflare R2 (S3-compatible) — from R2 > Manage API tokens (account token,
# Object Read & Write, scoped to the bucket). Account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mp3-player-music

# Shared passphrase the app must present to /api endpoints (min 8 chars).
APP_PASSPHRASE=
